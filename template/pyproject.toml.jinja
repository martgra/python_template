[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [{ name = "{{ user_name }}", email = "{{ user_email }}" }]
requires-python = ">={{ python_version }}"
readme = "README.md"
dependencies = []

[dependency-groups]
dev = [
    "deptry>=0.23.1",
    "detect-secrets>=1.5.0",
    "prek>=0.3.0",
    "pylint>=4.0.4",
    "pysentry-rs>=0.3.14",
    "ruff>=0.14.13",
{% if use_ty %}    "ty>=0.0.13",
{% endif %}    "vulture>=2.14",
]
test = [
    "pytest>=8.4.2",
    "pytest-cov>=7.0.0",
]

[tool.uv]
default-groups = [
    "dev",
    "test",
]

[tool.hatch.build.targets.sdist]
include = ["{{ package_name }}"]

[tool.hatch.build.targets.wheel]
include = ["{{ package_name }}"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
exclude = ["tests/*"]

[tool.ruff.lint]
extend-ignore = ["E203"]
select = ["A", "B", "C4", "D", "E", "F", "I", "N", "PERF", "PT", "RUF", "SIM", "UP", "W"]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["D104"]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.pylint]
max-line-length = 100
disable = ["all"]
enable = [
  # cyclic imports and cross-file duplication
  "R0401",  # cyclic-import
  "R0801",  # duplicate-code

  # inheritance / interface contract
  "E0110",  # abstract-class-instantiated
  "E0202",  # method-hidden
  "W0221",  # arguments-differ
  "W0222",  # signature-differs
  "W0223",  # abstract-method
  "W0231",  # super-init-not-called
  "W0233",  # non-parent-init-called
  "W0236",  # invalid-overridden-method
  "W0237",  # arguments-renamed
  "W0239",  # overridden-final-method
  "W0240",  # subclassed-final-class
  "W0246",  # useless-parent-delegation
  "R0901",  # too-many-ancestors

  # cross-module type inference
  "E1101",  # no-member
  "E0611",  # no-name-in-module
  "E1102",  # not-callable
  "E1111",  # assignment-from-no-return
  "E1120",  # no-value-for-parameter
  "E1121",  # too-many-function-args
  "E1123",  # unexpected-keyword-arg
  "E1124",  # redundant-keyword-arg
  "E1128",  # assignment-from-none

  # deprecated API usage across modules
  "W4901",  # deprecated-module
  "W4902",  # deprecated-method
  "W4903",  # deprecated-argument
  "W4904",  # deprecated-class
  "W4905",  # deprecated-decorator
]

[tool.deptry]
known_first_party = ["{{ package_name }}"]

[tool.pytest]
testpaths = ["tests"]

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.vulture]
make_whitelist = true
min_confidence = 80
paths = ["{{ package_name }}"]
sort_by_size = true
